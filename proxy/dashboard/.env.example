# ImmuniSOC-Nexus Dashboard Environment Variables

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:8080/api
REACT_APP_REFRESH_INTERVAL=30000
REACT_APP_RETRY_ATTEMPTS=3
REACT_APP_TIMEOUT_MS=10000

# Feature Flags
REACT_APP_FEATURE_EMERGENCY_RESPONSE=true
REACT_APP_FEATURE_BLOCK_IP=true
REACT_APP_FEATURE_AUDIT=true

# Debugging
REACT_APP_DEBUG_MODE=false