# ImmuniSOC-Nexus Proxy Environment Variables
# Copy this file to .env and set appropriate values

# Required security tokens (no fallbacks - must be set!)
HANDSHAKE_TOKEN=your_secure_handshake_token_here
SECURITY_ADMIN_TOKEN=your_admin_token_here

# Certificate paths for mTLS (optional - if not set, runs in reduced security mode)
CA_CERT_PATH=/path/to/ca-cert.pem
SERVER_CERT_PATH=/path/to/server-cert.pem
SERVER_KEY_PATH=/path/to/server-key.pem

# Service communication key for request signing
SERVICE_COMMUNICATION_KEY=your_service_communication_key_here

# Backend configuration
BACKEND_HOST=localhost:8081

# OPA Configuration
OPA_POLICY_URL=http://opa:8181/v1/data/authz/allow
OPA_EGRESS_POLICY_URL=http://opa:8181/v1/data/egress/allow
OPA_POPIA_POLICY_URL=http://opa:8181/v1/data/popia/allow
OPA_BLOCK_POLICY_URL=http://opa:8181/v1/data/egress/block_egress
OPA_IMAGE=openpolicyagent/opa:0.60.0-released

# Trusted proxy configuration (comma-separated CIDR blocks)
TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8

# Dashboard configuration
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Handshake secret for development (not for production)
# For production, always use HANDSHAKE_TOKEN instead
# HANDSHAKE_SECRET_TOKEN=development_only_secret