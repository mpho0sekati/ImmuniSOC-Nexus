# ImmuniSOC-Nexus Environment Configuration
# Copy this file to .env and customize for your environment

# Proxy Configuration
PROXY_PORT=8080
BACKEND_URL=http://localhost:8081
PROXY_TIMEOUT=30s
MAX_CONNECTIONS=1000

# Security Configuration - IMPORTANT: These must meet security requirements
# Minimum 16 characters with uppercase, lowercase, digits, and special characters
HANDSHAKE_SECRET_TOKEN=YourSecureHandshakeToken123!
SECURITY_ADMIN_TOKEN=YourSecureAdminToken123!
JWT_SECRET=YourSecureJWTSecret123!
ENCRYPTION_KEY=YourSecureEncryptionKey123!

# OPA Configuration
OPA_URL=http://localhost:8181

# Logging Configuration
LOG_FILE_PATH=./logs/security.log
LOG_LEVEL=info
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Feature Flags
HONEYTOKEN_ENABLED=true
DECEPTION_ENABLED=true
MICROSEG_ENABLED=true
RBAC_ENABLED=true

# Dashboard Configuration
DASHBOARD_REFRESH_INTERVAL=30s
DASHBOARD_RETRY_ATTEMPTS=3
DASHBOARD_TIMEOUT=10s